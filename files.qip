# Source list for the MiSTer build. The project's .qsf sources this file and
# nothing else, so anything the core needs has to be here.
#
# The Verilog under rtl/ and verilog/ is what the Verilator simulation builds
# and what every measurement in this tree was taken against. The VHDL under
# source/ is the original core, kept for the GHDL simulation in sim/, and is
# deliberately not built here: several of its entities share names with the
# Verilog ones, so including both defines the same module twice.

# MiSTer framework and top level
set_global_assignment -name QIP_FILE sys/sys.qip
set_global_assignment -name SYSTEMVERILOG_FILE "Arcade-SuperBug.sv"
set_global_assignment -name QIP_FILE rtl/pll.qip

# Controls
set_global_assignment -name SYSTEMVERILOG_FILE joy2quad.sv
set_global_assignment -name SYSTEMVERILOG_FILE gearshift.sv

# Core
set_global_assignment -name VERILOG_FILE rtl/superbug.v
set_global_assignment -name VERILOG_FILE rtl/cpu_mem.v
set_global_assignment -name VERILOG_FILE rtl/synchronizer.v
set_global_assignment -name VERILOG_FILE rtl/playfield.v
set_global_assignment -name VERILOG_FILE rtl/alpha_numerics.v
set_global_assignment -name VERILOG_FILE rtl/car.v
set_global_assignment -name VERILOG_FILE rtl/trailer.v
set_global_assignment -name VERILOG_FILE rtl/mixer.v
set_global_assignment -name VERILOG_FILE rtl/sound.v
set_global_assignment -name VERILOG_FILE rtl/Input.v

# Memories: inferred block RAM with a loader write port, shared with the
# Verilator build. The ROM image arrives from the MRA at run time.
set_global_assignment -name VERILOG_FILE rtl/memories.v

# Processor, sync PROM and engine sound generator
set_global_assignment -name VERILOG_FILE verilog/cpu68.v
set_global_assignment -name VERILOG_FILE verilog/prom.v
set_global_assignment -name VERILOG_FILE verilog/enginesound.v
