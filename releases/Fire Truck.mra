<misterromdescription>
    <name>Fire Truck</name>
    <setname>firetrk</setname>
    <rbf>Arcade-SuperBug</rbf>
    <year>1978</year>
    <manufacturer>Atari</manufacturer>
    <category>Driving</category>

    <!-- Game select. The core reads this as a one byte download at index 1:
         0 is Super Bug, 1 is Fire Truck. -->
    <rom index="1"><part>01</part></rom>

    <rom index="0" zip="firetrk.zip" md5="none">
        <!-- Program, $2000-$3FFF. The two nibble-wide PROM pairs at K and J
             interleave into the top half. -->
        <part name="032826-01.c1"/>
        <part name="032825-01.d1"/>
        <part name="032816-01.k1"/>
        <part name="032820-01.k2"/>
        <part name="032815-01.j1"/>
        <part name="032819-01.j2"/>
        <!-- Alphanumeric character generator -->
        <part name="032827-01.r3"/>
        <!-- Playfield tiles -->
        <part name="032828-02.f5"/>
        <!-- Truck sprite -->
        <part name="032831-01.p7"/>
        <!-- Trailer sprite -->
        <part name="032829-01.j5"/>
        <part name="032830-01.l5"/>
        <!-- Sync PROM, the same part Super Bug uses -->
        <part name="009114.prm"/>
    </rom>

    <!--
        Same four switches as Super Bug, in the order the multiplexer presents
        them. Fire Truck also puts coinage on the first bank rather than
        leaving it empty, which the input module still has to be taught.

        Default 0x98 is 1 coin 1 play, 90 seconds, medium extended play,
        English.
    -->
    <switches default="98" base="16">
        <dip name="Language"       bits="0,1" ids="English,French,Spanish,German"/>
        <dip name="Extended Play"  bits="2,3" ids="Never,Liberal,Medium,Conservative"/>
        <dip name="Game Time"      bits="4,5" ids="60 Seconds,90 Seconds,120 Seconds,150 Seconds"/>
        <dip name="Coinage"        bits="6,7" ids="Free Play,1 Coin 2 Plays,1 Coin 1 Play,2 Coins 1 Play"/>
    </switches>

    <buttons names="Gas,Horn,Bell,Track Select,Start 1P,Start 2P,Coin" default="A,B,X,Y,Start,Select,R"/>
</misterromdescription>
